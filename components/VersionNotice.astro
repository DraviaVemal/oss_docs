---
import starlightConfig from "virtual:starlight/user-config";
import starlightVersionsConfig from "virtual:starlight-versions-config";

import {
  getVersionFromSlug,
  getVersionURL,
} from "../node_modules/starlight-versions/libs/versions";

const pageVersion = getVersionFromSlug(
  starlightVersionsConfig,
  starlightConfig,
  (Astro.locals as any).starlightRoute.entry.slug
);
---

{
  pageVersion && (
    <p>
      <span>
        This content is for{" "}
        {pageVersion.label ?? `the ${pageVersion.slug} version`}. Switch to the
        {/* prettier-ignore */}
        <a class="link-ul" href={getVersionURL(starlightVersionsConfig, starlightConfig, Astro.url, undefined).pathname}>Stable version.</a>
      </span>
    </p>
  )
}

<style>
  p {
    display: block;
    text-align: center;
    border: 1px solid var(--sl-color-orange);
    padding: 0.75em 1em;
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    width: 100%;
    max-width: 100%;
    gap: 0.75em;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-height-headings);
  }

  p a {
    color: var(--sl-color-orange-high);
  }

  p :global(svg) {
    flex-shrink: 0;
  }
</style>
