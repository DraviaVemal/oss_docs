---
import starlightConfig from "virtual:starlight/user-config";
import starlightVersionsConfig from "virtual:starlight-versions-config";
import { getVersionURL } from "../node_modules/starlight-versions/libs/versions";

const { entry } = (Astro.locals as any).starlightRoute;

const pageVersion = parseFloat(Astro.url.pathname.split("/")[2]);

const isLandingPage = entry.data.template === "splash";
---

{
  !isNaN(pageVersion) && !isLandingPage && (
    <p>
      <span>
        This content is for v{pageVersion}.x version. Switch to the&nbsp;
        {/* prettier-ignore */}
        <a class="link-ul" href={getVersionURL(starlightVersionsConfig, starlightConfig, Astro.url, undefined).pathname}>Stable version.</a>
      </span>
    </p>
  )
}

<style>
  p {
    display: block;
    text-align: center;
    border: 1px solid var(--sl-color-orange);
    padding: 0.75em 1em;
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    width: 100%;
    max-width: 100%;
    gap: 0.75em;
    font-size: var(--sl-text-sm);
    line-height: var(--sl-line-height-headings);
  }

  p a {
    color: var(--sl-color-orange-high);
  }

  p :global(svg) {
    flex-shrink: 0;
  }
</style>
