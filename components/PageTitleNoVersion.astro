---
/**
 * PageTitle override for single-version docs sites (no `starlight-versions`).
 * Renders the page `<h1>` (important for SEO) without the version notice, so it
 * can be used by projects that do not register the versions plugin.
 */
const { entry } = (Astro.locals as any).starlightRoute;

const isLandingPage = entry.data.template === "splash";
---

<h1 id="_top" data-page-title>{entry.data.title}</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
{
  !isLandingPage && (
    <>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-2944495108494397"
        data-ad-slot="9072889243"
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script>
        // @ts-ignore
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </>
  )
}
